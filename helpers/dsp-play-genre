#!/bin/sh
# Play tracks of a genre, favourites-first. Shuffle on.
#   (default)    your FAVOURITED tracks for that genre
#   -a / --all   every matching track you own — favourites plus the rest
#   -n           dry run: report the track count, don't change playback
# Name is matched exactly (case-insensitive), as listed by `dsp-genres`.
#
# Plays via the "HiFi Queue" temp playlist (rebuilt each run) rather than an
# anonymous track-list queue: with a real current playlist, Music's native
# previous/next work, so the dashboard's back button can jump BETWEEN tracks.
# duplicate uses the SPECIFIER form (an evaluated track list fails, -10006),
# with a per-track fallback that skips any track that won't copy.
dry=0; allmode=0
while [ "${1#-}" != "$1" ]; do
  case "$1" in
    -n) dry=1 ;;
    -a|--all) allmode=1 ;;
    --) shift; break ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
  shift
done
[ -z "$1" ] && { echo "usage: dsp-play-genre [-n] [-a] <genre>" >&2; exit 2; }

osascript - "$dry" "$allmode" "$1" <<'APPLESCRIPT'
on run argv
  set dry to (item 1 of argv) is "1"
  set allMode to (item 2 of argv) is "1"
  set q to item 3 of argv
  if allMode then
    set lbl to " (all)"
  else
    set lbl to " (favourites)"
  end if
  tell application "Music"
    if allMode then
      set c to count (every track of library playlist 1 whose genre is q)
    else
      set c to count (every track of library playlist 1 whose genre is q and favorited is true)
    end if
    if c is 0 then return "NOTHING FOUND for genre: " & q
    if dry then return "WOULD PLAY " & c & " tracks — genre " & q & lbl
    if not (exists user playlist "HiFi Queue") then
      make new user playlist with properties {name:"HiFi Queue"}
    end if
    delete every track of user playlist "HiFi Queue"
    try
      if allMode then
        duplicate (every track of library playlist 1 whose genre is q) to user playlist "HiFi Queue"
      else
        duplicate (every track of library playlist 1 whose genre is q and favorited is true) to user playlist "HiFi Queue"
      end if
    end try
    if (count tracks of user playlist "HiFi Queue") is 0 then
      if allMode then
        set sel to (every track of library playlist 1 whose genre is q)
      else
        set sel to (every track of library playlist 1 whose genre is q and favorited is true)
      end if
      repeat with tr in sel
        try
          duplicate tr to user playlist "HiFi Queue"
        end try
      end repeat
    end if
    set n to count tracks of user playlist "HiFi Queue"
    if n is 0 then return "QUEUE BUILD FAILED for genre: " & q
    set shuffle enabled to true
    play user playlist "HiFi Queue"
    return "PLAYING " & n & " tracks — genre " & q & lbl
  end tell
end run
APPLESCRIPT
